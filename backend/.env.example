# Copy to backend/.env for local development. Never commit real values.
APP_ENV=development
# Claude API key (server-side only). Leave empty to run with the demo provider only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Local default is SQLite. For Supabase use the Postgres connection string (postgresql://...).
DATABASE_URL=sqlite:///./tracecare.db
# Comma-separated exact frontend origins (no wildcard).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEMO_MODE_ENABLED=true
# Optional shared password for the public demo (validated server-side). Empty = no gate.
DEMO_ACCESS_PASSWORD=
MAX_TRANSCRIPT_CHARS=30000
# Per client IP, e.g. 20/hour. "off" disables. Stored in the database (works on serverless).
ANALYSIS_RATE_LIMIT=20/hour
# REQUIRED in production: >= 32 random characters. Signs demo sessions and hashes client IPs.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Saved encounters older than this many days are deleted automatically (0 = keep).
ENCOUNTER_RETENTION_DAYS=7
# Optional tuning
# ANTHROPIC_EFFORT=medium
# LLM_TIMEOUT_SECONDS=120
# LLM_MAX_OUTPUT_TOKENS=16000
# Set to true on Vercel / other serverless hosts (no idle DB connection pool).
SERVERLESS=false
